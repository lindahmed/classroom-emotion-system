EDUPULSE_DB_HOST=localhost
EDUPULSE_DB_PORT=5432
EDUPULSE_DB_NAME=edupulse_ai
EDUPULSE_DB_USER=postgres
EDUPULSE_DB_PASSWORD=change_me

# Optional single URL fallback (otherwise host/port/name/user/password above are used)
# DATABASE_URL=postgresql://user:password@localhost:5432/edupulse_ai

AUTH_SECRET=replace_with_a_long_random_secret
TOKEN_EXPIRY_MINUTES=60

# Logs: DEBUG, INFO, WARNING, ERROR
EDUPULSE_LOG_LEVEL=INFO

# CORS: leave empty so localhost:any-port Shiny regex is allowed. Set comma list for production origins.
# EDUPULSE_CORS_ORIGINS=http://127.0.0.1:3838,http://localhost:3838

# Lightweight emotion path (opencv = fast; deepface = heavier TF emotion model; vit = ViT AffectNet ~95% accuracy)
EDUPULSE_EMOTION_ENGINE=opencv
# ViT model from HuggingFace (used when EDUPULSE_EMOTION_ENGINE=vit)
# EDUPULSE_VIT_MODEL=mo-thecreator/vit-Facial-Expression-Recognition

# DeepFace.verify / find embedding model for recognition (default SFace = lighter)
EDUPULSE_FACE_MODEL=SFace
EDUPULSE_FACE_DISTANCE_METRIC=euclidean_l2
# How strict verification is vs gallery (lift to ~1.2–1.35 if enrollment vs webcam lighting differs).
EDUPULSE_FACE_DISTANCE_THRESHOLD=1.15
# Merge overlapping Haar detections before counting faces (lower = fewer duplicate boxes).
EDUPULSE_FACE_NMS_IOU=0.35
# Haar≤this count ⇒ full-frame DeepFace.find(opencv detector) like classroom-emotion-system-fixed; 2+ ⇒ per-crop.
EDUPULSE_FULLFRAME_FIND_MAX_HAAR_FACES=1
# Detector name for full-frame DeepFace.find
EDUPULSE_FULLFRAME_DETECTOR=opencv

# SMTP (for password reset emails — use app passwords / SMTP credentials, never commit real secrets)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=EduPulse AI
SMTP_USE_TLS=true
