# ── Rename this file to `.env` in the PROJECT ROOT — read by app.R automatically; FastAPI reads root + backend/.env.
# ── Recommended: merge with keys from backend/.env.example (copy those lines here).

# PostgreSQL (R + backend)
EDUPULSE_DB_HOST=localhost
EDUPULSE_DB_PORT=5432
EDUPULSE_DB_NAME=edupulse_ai
EDUPULSE_DB_USER=admin
EDUPULSE_DB_PASSWORD=password

# R app ↔ FastAPI URL (camera JS + httr requests). No trailing slash.
EDUPULSE_API_BASE_URL=http://localhost:8000

# R app data source switch
EDUPULSE_USE_DB=true

# Backend authentication (duplicate here if backend/.env absent)
AUTH_SECRET=replace_with_a_long_random_secret
TOKEN_EXPIRY_MINUTES=60

# Optional: tighter/looser face match (mirror backend defaults)
# EDUPULSE_FACE_DISTANCE_THRESHOLD=1.15
